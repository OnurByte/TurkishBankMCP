{
  "name": "turkish-bank-mcp",
  "version": "0.4.0",
  "description": "Read-only MCP server for direct Garanti BBVA API Store account information and transaction access.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "inspect": "npx @modelcontextprotocol/inspector npx tsx src/index.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "dotenv": "17.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "tsx": "4.20.0",
    "typescript": "5.8.3"
  },
  "license": "MIT"
}
