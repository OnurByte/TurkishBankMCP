# mock = safe local demo, ohvps = live ÖHVPS-compatible provider endpoint
BANK_PROVIDER=mock

# Turkish Open Banking specification targeted by this project.
OHVPS_SPEC_VERSION=2.0.0

# Base URL must point to the HBH s2.0 resource root, e.g.:
# https://provider.example/ohvps/hbh/s2.0
OHVPS_BASE_URL=

# Production ÖHVPS is not a simple personal-bank API key flow.
# These values are supplied by/for an authorized YÖS/HBHS or an aggregator.
OHVPS_TPP_CODE=
OHVPS_ASPSP_CODE=
OHVPS_GATEWAY_TOKEN=
OHVPS_ACCESS_TOKEN=

# Optional protocol headers. Leave empty unless your provider requires them.
OHVPS_GROUP_ID=
OHVPS_PSU_FRAUD_CHECK=

HTTP_TIMEOUT_MS=12000
