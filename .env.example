# Garanti BBVA API Store direct integration
# Create an app in Garanti Developer Portal and subscribe ONLY to:
# - Account Information
# - Account Transactions

GARANTI_TOKEN_URL=https://apis.garantibbva.com.tr/auth/oauth/v2/token
GARANTI_CLIENT_ID=
GARANTI_CLIENT_SECRET=
GARANTI_CLIENT_SECRET_FILE=
GARANTI_REDIRECT_URI=https://your-public-https-callback.example/callback

# Garanti keeps the product-specific endpoint path and request schema inside the portal.
# Copy the exact values shown for your approved Account Information product.
GARANTI_ACCOUNT_INFORMATION_URL=
GARANTI_ACCOUNT_INFORMATION_METHOD=
GARANTI_ACCOUNT_INFORMATION_CONTENT_TYPE=application/json
GARANTI_ACCOUNT_INFORMATION_BODY_TEMPLATE=

# Copy the exact values shown for your approved Account Transactions product.
# URL/body templates may use these placeholders:
# {{accountRef}} {{from}} {{to}} {{direction}} {{minAmount}} {{maxAmount}} {{page}} {{pageSize}}
GARANTI_ACCOUNT_TRANSACTIONS_URL=
GARANTI_ACCOUNT_TRANSACTIONS_METHOD=
GARANTI_ACCOUNT_TRANSACTIONS_CONTENT_TYPE=application/json
GARANTI_ACCOUNT_TRANSACTIONS_BODY_TEMPLATE=

# Optional extra headers required by the product documentation.
# Authorization is always generated by TurkishBankMCP and cannot be overridden here.
GARANTI_EXTRA_HEADERS_JSON={}

HTTP_TIMEOUT_MS=12000
HTTP_MAX_RETRIES=2
HTTP_RETRY_BASE_MS=500
HTTP_MAX_RETRY_WAIT_MS=5000
