# mock = local demo, ohvps = real ÖHVPS-compatible account-information endpoint
BANK_PROVIDER=mock
OHVPS_SPEC_VERSION=2.0.0

# Example: https://provider.example/ohvps/hbh/s2.0
OHVPS_BASE_URL=
OHVPS_TPP_CODE=
OHVPS_ASPSP_CODE=

# Secrets may be supplied inline...
OHVPS_GATEWAY_TOKEN=
OHVPS_ACCESS_TOKEN=
OHVPS_PSU_FRAUD_CHECK=

# ...or from files. File values take precedence over inline values and are
# re-read before each request so an external process can rotate tokens.
OHVPS_GATEWAY_TOKEN_FILE=
OHVPS_ACCESS_TOKEN_FILE=
OHVPS_PSU_FRAUD_CHECK_FILE=

# Optional. A process-stable UUID is generated when omitted.
OHVPS_GROUP_ID=

HTTP_TIMEOUT_MS=12000
HTTP_MAX_RETRIES=2
HTTP_RETRY_BASE_MS=500
HTTP_MAX_RETRY_WAIT_MS=5000

# Sensitive API responses are cached here across process restarts.
# Set CACHE_FILE=off to disable persistent cache.
CACHE_FILE=.data/cache.json
