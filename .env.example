# mock = local demo
# kobakus = easiest live/sandbox route for supported banks
# ohvps = direct ÖHVPS-compatible provider/gateway
BANK_PROVIDER=mock

# Kobaküs KWAP
KOBAKUS_ENDPOINT=https://app.kobakus.com/webservice/BankPaymentList.php
KOBAKUS_FIRM_CODE=
KOBAKUS_CHANNEL_CODE=
KOBAKUS_PASSWORD=

# Optional. Prefer this over putting the password directly in .env.
# The file is re-read for every request.
KOBAKUS_PASSWORD_FILE=

# Direct ÖHVPS 2.0.0
OHVPS_SPEC_VERSION=2.0.0
OHVPS_BASE_URL=
OHVPS_TPP_CODE=
OHVPS_ASPSP_CODE=

OHVPS_GATEWAY_TOKEN=
OHVPS_ACCESS_TOKEN=
OHVPS_PSU_FRAUD_CHECK=

# Optional rotating secret files
OHVPS_GATEWAY_TOKEN_FILE=
OHVPS_ACCESS_TOKEN_FILE=
OHVPS_PSU_FRAUD_CHECK_FILE=

OHVPS_GROUP_ID=

HTTP_TIMEOUT_MS=12000
HTTP_MAX_RETRIES=2
HTTP_RETRY_BASE_MS=500
HTTP_MAX_RETRY_WAIT_MS=5000

# Bank responses are cached here across process restarts.
# Set CACHE_FILE=off to disable persistent cache.
CACHE_FILE=.data/cache.json
